<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blogging Site</title>
    <link rel="stylesheet" href="home.css">

</head>
<body>

  <!-- Navbar -->
<%- include('./components/Navbar') %>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h2>Welcome to My Blogging Site</h2>
      <p>Read amazing articles and share your ideas with the world.</p>
      <button>Explore Blogs</button>
    </div>
  </section>

  <!-- Blog Cards -->
  <section class="blogs">
    <h2>Latest Blogs</h2>

    <div class="blog-container">

      <div class="blog-card">
        <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1000&auto=format&fit=crop" alt="">
        <div class="blog-content">
          <h3>Web Development</h3>
          <p>Learn the basics of HTML, CSS, and JavaScript.</p>
          <a href="#">Read More</a>
        </div>
      </div>

      <div class="blog-card">
        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?q=80&w=1000&auto=format&fit=crop" alt="">
        <div class="blog-content">
          <h3>Programming Tips</h3>
          <p>Improve your coding skills with useful tips and tricks.</p>
          <a href="#">Read More</a>
        </div>
      </div>

      <div class="blog-card">
        <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1000&auto=format&fit=crop" alt="">
        <div class="blog-content">
          <h3>Technology News</h3>
          <p>Stay updated with the latest trends in technology.</p>
          <a href="#">Read More</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Footer -->
<%- include("./components/footer") %>

</body>
</html>